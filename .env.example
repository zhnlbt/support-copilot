# demo: synthetic fixtures, no network calls. api: existing backend /triage.
VITE_DATA_MODE=demo
# In production, use a same-origin reverse proxy at /api (recommended).
# For a different origin, configure backend CORS before changing this value.
VITE_API_BASE_URL=/api
# Development proxy only; never exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
